---
const { url, name } = Astro.props

interface Props {
  url: string
  name: string
}

const isVirtualEnv = url === 'https://eva.losandesc.com/'
---

<a
    id={url === '/' ? 'home' : url.replace('/', '')}
    href={url}
    data-astro-prefetch
    class:list={[
        "rounded-lg text-base font-medium outline-none ring-zinc-500 focus-visible:ring dark:ring-zinc-200 dark:focus:outline-none md:py-3 md:text-sm 2xl:text-base px-4 transition-colors duration-200",
        isVirtualEnv 
            ? "virtual-env-btn" 
            : "text-neutral-600 hover:text-neutral-500 dark:text-neutral-400 dark:hover:text-neutral-500"
    ]}
>
  {name}
</a>

<style>
    .virtual-env-btn {
        background-color: rgb(43, 2, 78) !important;
        color: white !important;
    }
    .virtual-env-btn:hover {
        background-color: rgb(57, 2, 109) !important;
    }
    .dark .virtual-env-btn {
        background-color: rgb(57, 2, 109) !important;
        color: white !important;
    }
    .dark .virtual-env-btn:hover {
        background-color: rgb(126, 34, 206) !important;
    }

    /* Estilos para el enlace activo */
    a[aria-current="page"] {
        background-color: rgb(30, 58, 138) !important;
        color: white !important;
    }

    .dark a[aria-current="page"] {
        background-color: rgb(30, 64, 175) !important;
        color: white !important;
    }
</style>

<script>
 document.addEventListener('DOMContentLoaded', () => {
     const currentPath = window.location.pathname
     const navLinks = document.querySelectorAll('a[data-astro-prefetch]')
     
     navLinks.forEach(link => {
         const linkPath = link.getAttribute('href')
         if (linkPath && !linkPath.includes('eva.losandesc.com')) {
             // Para la página de inicio
             if (linkPath === '/' && currentPath === '/') {
                 link.classList.remove(
                     'text-neutral-600',
                     'dark:text-neutral-400',
                     'hover:text-neutral-500',
                     'dark:hover:text-neutral-500',
                 )
                 link.classList.add('bg-blue-900', 'text-white', 'dark:bg-blue-800', 'dark:text-white')
                 link.setAttribute('aria-current', 'page')
             }
             // Para la página de blog
             else if (linkPath === '/timeline' && currentPath === '/timeline') {
                 link.classList.remove(
                     'text-neutral-600',
                     'dark:text-neutral-400',
                     'hover:text-neutral-500',
                     'dark:hover:text-neutral-500',
                 )
                 link.classList.add('bg-blue-900', 'text-white', 'dark:bg-blue-800', 'dark:text-white')
                 link.setAttribute('aria-current', 'page')
             }
             // Para la página de noticias
             else if (linkPath === '/posts' && currentPath.startsWith('/posts') && !currentPath.includes('/contactanos')) {
                 link.classList.remove(
                     'text-neutral-600',
                     'dark:text-neutral-400',
                     'hover:text-neutral-500',
                     'dark:hover:text-neutral-500',
                 )
                 link.classList.add('bg-blue-900', 'text-white', 'dark:bg-blue-800', 'dark:text-white')
                 link.setAttribute('aria-current', 'page')
             }
             // Para la página de contacto
             else if (linkPath === '/posts/contactanos' && currentPath === '/posts/contactanos') {
                 link.classList.remove(
                     'text-neutral-600',
                     'dark:text-neutral-400',
                     'hover:text-neutral-500',
                     'dark:hover:text-neutral-500',
                 )
                 link.classList.add('bg-blue-900', 'text-white', 'dark:bg-blue-800', 'dark:text-white')
                 link.setAttribute('aria-current', 'page')
             }
         }
     })
 })
</script>
