---
const { url, name } = Astro.props

interface Props {
  url: string
  name: string
}

const isVirtualEnv = url === 'https://eva.losandesc.com/'
---

<a
    id={url === '/' ? 'home' : url.replace('/', '')}
    href={url}
    data-astro-prefetch
    class:list={[
        "rounded-lg text-base font-medium outline-none ring-zinc-500 focus-visible:ring dark:ring-zinc-200 dark:focus:outline-none md:py-3 md:text-sm 2xl:text-base px-4 transition-colors duration-200",
        isVirtualEnv 
            ? "virtual-env-btn" 
            : "text-neutral-600 hover:text-neutral-500 dark:text-neutral-400 dark:hover:text-neutral-500"
    ]}
>
  {name}
</a>

<style>
    .virtual-env-btn {
        background-color: rgb(43, 2, 78) !important;
        color: white !important;
    }
    .virtual-env-btn:hover {
        background-color: rgb(57, 2, 109) !important;
    }
    .dark .virtual-env-btn {
        background-color: rgb(57, 2, 109) !important;
        color: white !important;
    }
    .dark .virtual-env-btn:hover {
        background-color: rgb(126, 34, 206) !important;
    }
</style>

<script>
 document.addEventListener('DOMContentLoaded', () => {
     const url = window.location.pathname.replace('//', '')
     let navId = 'home'

     if (url !== '/') {
         navId = url.replace('/', '')
     }

     const nav = document.getElementById(navId) as HTMLAnchorElement
     if (nav && !nav.href.includes('eva.losandesc.com')) {
         nav.classList.remove(
             'text-neutral-600',
             'dark:text-neutral-400',
             'hover:text-neutral-500',
             'dark:hover:text-neutral-500',
         )
         nav.classList.add('text-yellow-600', 'dark:text-blue-400')
         nav.setAttribute('aria-current', 'page')
     }
 })
</script>
