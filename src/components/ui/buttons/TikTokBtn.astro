---
const { url, title } = Astro.props

interface Props {
  url: string
  title?: string
}
---

<a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-x-2 rounded-lg bg-[#000000] px-4 py-3 text-sm font-bold text-white transition duration-300 hover:bg-[#333333]"
>
   
    {title || 'Síguenos en TikTok'}
</a> 